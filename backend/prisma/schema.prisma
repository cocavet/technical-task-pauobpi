generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model lead {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  firstName   String
  lastName    String
  email       String
  jobTitle    String?
  countryCode String?
  companyName String?
  companyWebsite String?
  phoneEnrichmentStatus String?
  phoneEnrichmentProvider String?
  phoneEnrichmentError String?
  phoneEnrichmentRequestId String?
  phoneEnrichmentRunId String?
  phoneEnrichmentStartedAt DateTime?
  phoneEnrichedAt DateTime?
  phoneNumber String?
  yearsAtCompany Int?
  linkedinUrl String?
  message     String?
  emailVerified Boolean?
}
